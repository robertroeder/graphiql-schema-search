{
  "name": "graphiql-schema-search",
  "version": "1.1.0",
  "description": "Schema search for GraphiQL",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@graphiql/react": ">=0.20",
    "graphql": ">=15",
    "react": ">=17",
    "react-dom": ">=17"
  },
  "devDependencies": {
    "virtua": "^0.49.0",
    "@graphiql/react": "^0.29.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "graphql": "^16.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertroeder/graphiql-schema-search.git"
  },
  "license": "MIT"
}
